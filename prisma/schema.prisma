generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String?
  role        Role     @default(USER)
  provider    String   @default("local")
  providerId  String?
  avatar      String?
  isVerified  Boolean  @default(false)

  phone       String?
  address     String?
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  verifyEmailToken   String?
  verifyEmailExpires DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens  RefreshToken[]
  uploadedFiles UploadedFile[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  userRoles     UserRole[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(512)
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UploadedFile {
  id           Int      @id @default(autoincrement())
  originalName String
  fileName     String
  filePath     String
  fileUrl      String
  mimeType     String
  size         Int
  folder       String?
  type         FileType @default(OTHER)
  uploadedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum FileType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum NotificationType {
  SYSTEM
  SECURITY
  ACCOUNT
  ORDER
  APPOINTMENT
  COURSE
  OTHER
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  method    String?
  path      String?
  ip        String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id               Int      @id @default(autoincrement())
  siteName         String   @default("Full-stack Auth Core")
  siteLogo         String?
  systemEmail      String?
  allowRegister    Boolean  @default(true)
  allowGoogleLogin Boolean  @default(true)
  allowFacebookLogin Boolean @default(true)
  maintenanceMode  Boolean  @default(false)
  maxUploadSizeMB Int      @default(10)
  defaultUserRole String   @default("USER")
  supportEmail    String?
  footerText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppRole {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String
  description String?
  group       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appRole AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  appRole    AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}
